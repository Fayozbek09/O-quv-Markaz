DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oquv_markaz?schema=public&sslmode=require"
APP_URL="https://oquvmarkaz.uz"
NODE_ENV="production"
SESSION_SECRET=""
OTP_PEPPER=""
FILE_URL_SECRET=""
IP_HASH_SECRET=""
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
SMS_PROVIDER="console"
# Eskiz.uz account e-mail and password, plus the approved sender nickname.
# 4546 is the shared short code every account may use before one is granted.
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
# Play Mobile, the alternative gateway.
PLAYMOBILE_LOGIN=""
PLAYMOBILE_PASSWORD=""
PLAYMOBILE_ORIGINATOR="3700"
EMAIL_PROVIDER="console"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
PAYMENT_PROVIDER="manual"
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
# The service_id issued by the Click merchant cabinet.
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Human-verification challenge on registration and password reset. Both of
# those send an SMS, and an SMS costs money — rate limiting bounds one IP, not
# a thousand. `none` is a supported way to run; the app keeps rate limiting as
# its only defence and the preflight says so at boot.
#   none | turnstile | hcaptcha | recaptcha
CAPTCHA_PROVIDER="none"
CAPTCHA_SITE_KEY=""
CAPTCHA_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Published support details. These appear in the site footer and on the legal
# pages, so they are NEXT_PUBLIC_ on purpose — they are not secrets. Leave
# NEXT_PUBLIC_CONTACT_TELEGRAM empty and the Telegram row is simply not shown;
# an unset handle must never become a dead link.
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_TELEGRAM=""

# ---------------------------------------------------------------------------
# Generate the four secrets below with:  openssl rand -hex 32
#   SESSION_SECRET     signs/derives session material
#   OTP_PEPPER         server-side pepper mixed into OTP hashes
#   FILE_URL_SECRET    HMAC key for signed file URLs
#   IP_HASH_SECRET     HMAC key used to pseudonymize IPs in logs
#
# SMS_PROVIDER   : console | eskiz | playmobile     (console = print to stdout)
# EMAIL_PROVIDER : console | smtp | resend
# PAYMENT_PROVIDER: manual | payme | click          (manual = no auto-activation)
#
# Payme and Click are wired to ONE endpoint: ${APP_URL}/api/billing/webhook
#   Payme  — a JSON-RPC merchant endpoint. Set it as the "Endpoint" in the
#            merchant cabinet; PAYME_SECRET_KEY is the cabinet's key, sent as
#            Basic auth under the username `Paycom`.
#   Click  — the SHOP API's Prepare/Complete URL. CLICK_MERCHANT_ID is the
#            service_id, CLICK_SECRET_KEY the secret key.
#
# In production the app refuses to start if a provider is named without its
# credentials, so a half-configured gateway cannot reach a paying customer.
#
# Google OAuth : https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${APP_URL}/api/auth/google/callback
# Telegram bot : create via @BotFather, then set the webhook to
#   ${APP_URL}/api/telegram/webhook  with secret_token = TELEGRAM_WEBHOOK_SECRET
# ---------------------------------------------------------------------------
