DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ustozly?schema=public&sslmode=require"
APP_URL="https://app.ustozly.uz"
NODE_ENV="production"
SESSION_SECRET=""
OTP_PEPPER=""
FILE_URL_SECRET=""
IP_HASH_SECRET=""
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
SMS_PROVIDER="console"
# Eskiz.uz account e-mail and password, plus the approved sender nickname.
# 4546 is the shared short code every account may use before one is granted.
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
# Play Mobile, the alternative gateway.
PLAYMOBILE_LOGIN=""
PLAYMOBILE_PASSWORD=""
PLAYMOBILE_ORIGINATOR="3700"
EMAIL_PROVIDER="console"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
PAYMENT_PROVIDER="manual"
PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""
# The service_id issued by the Click merchant cabinet.
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Generate the four secrets below with:  openssl rand -hex 32
#   SESSION_SECRET     signs/derives session material
#   OTP_PEPPER         server-side pepper mixed into OTP hashes
#   FILE_URL_SECRET    HMAC key for signed file URLs
#   IP_HASH_SECRET     HMAC key used to pseudonymize IPs in logs
#
# SMS_PROVIDER   : console | eskiz | playmobile     (console = print to stdout)
# EMAIL_PROVIDER : console | smtp | resend
# PAYMENT_PROVIDER: manual | payme | click          (manual = no auto-activation)
#
# Google OAuth : https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: ${APP_URL}/api/auth/google/callback
# Telegram bot : create via @BotFather, then set the webhook to
#   ${APP_URL}/api/telegram/webhook  with secret_token = TELEGRAM_WEBHOOK_SECRET
# ---------------------------------------------------------------------------
